# PyAuthService Environment Configuration
# Copy this to .env and update with your values

# Django Settings
DEBUG=False
SECRET_KEY=<secret-key>
ALLOWED_HOSTS=apis.hacksaw.in,auth.hacksaw.in
CSRF_TRUSTED_ORIGINS=https://apis.hacksaw.in,https://auth.hacksaw.in
CORS_ALLOWED_ORIGINS=https://hacksaw.in,https://analytics.hacksaw.in
STATIC_URL=/static/

# Require PKCE for authorization-code clients when all clients support it.
# Set true after configuring oauth2-proxy with S256 PKCE as well.
OAUTH2_PKCE_REQUIRED=False

# Database engine
DB_ENGINE=postgresql

# PostgreSQL
POSTGRES_DB=pyauthservice
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# Reuse PostgreSQL connections for this many seconds (0 disables persistence)
DB_CONN_MAX_AGE=60

# App variables and secrets
OIDC_ISS_ENDPOINT=<https://domain.com>
OIDC_RSA_PRIVATE_KEY=<rsa-private-key>

# Optional API scopes and RFC 8707 resource policy, both JSON objects.
# Replace the example client ID and resource URI with registered values.
OAUTH2_API_SCOPES={"pocketbase:access":"Access to the PocketBase API"}
OAUTH2_RESOURCE_POLICIES={"nginx-gateway":{"https://pocketbase.example.com/":["pocketbase:access"]}}
OAUTH2_CLIENT_DEFAULTS={"nginx-gateway":{"resources":["https://pocketbase.example.com/"],"scopes":["openid","email","profile","pocketbase:access"]}}

# Defaults used for clients without an OAUTH2_CLIENT_DEFAULTS entry.
# These preserve the prior behavior unless explicitly changed.
OAUTH2_DEFAULT_AUDIENCE=default-resource-service
OAUTH2_DEFAULT_SCOPES=read,write,openid,offline_access,email,profile

# Access tokens last 1 hour. Refresh tokens expire 365 days after the
# associated access token expires; increase this if longer oauth2-proxy
# sessions are required. Existing revoked/deleted refresh tokens cannot recover.
OAUTH2_ACCESS_TOKEN_EXPIRE_SECONDS=3600
OAUTH2_REFRESH_TOKEN_EXPIRE_SECONDS=31536000
